# Copy to .env and fill in values before first run
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated list of allowed origins (add http://localhost:PORT for local dev)
CORS_ORIGIN=https://clist.mooc.ca
DATA_DIR=/data
# Public URL of this kvstore instance — embedded as the JWT issuer claim
ISSUER_URL=https://kvstore.mooc.ca
